
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id           String   @id @default(uuid())
  title        String
  mode         String
  content      Json
  previewImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}