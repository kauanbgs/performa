# URL de conexão com o PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/performa"

# Segredo usado para assinar/verificar os JWTs de autenticação
JWT_SECRET="troque-por-um-valor-aleatorio-e-secreto"

# Porta em que o servidor Express sobe (opcional, padrão 3001)
PORT=3001

# Ambiente de execução: development | production
NODE_ENV=development
